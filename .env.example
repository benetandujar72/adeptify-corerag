# ───────── IA Nou Patufet · variables d'entorn ─────────
# Copia a `.env` i ajusta. NO versionar el .env real.

# Postgres + pgvector
POSTGRES_USER=patufet
# SENTINELLA: cal substituir-ho per una contrasenya forta abans de qualsevol ús real.
# Amb ENTORN!=dev, la porta d'arrencada AVORTA si detecta aquest placeholder.
POSTGRES_PASSWORD=CHANGEME-REQUIRED
POSTGRES_DB=patufet
DATABASE_URL=postgresql+psycopg://patufet:CHANGEME-REQUIRED@db:5432/patufet

# ── Abstracció de model (clau de la portabilitat) ──
# DEV (sense GPU): Ollama
#   OPENAI_BASE_URL=http://ollama:11434/v1
#   LLM_MODEL=qwen2.5:7b
# PILOT/PROD (GPU): vLLM
#   OPENAI_BASE_URL=http://vllm:8000/v1
#   LLM_MODEL=casperhansen/llama-3.3-70b-instruct-awq
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=sk-no-cal-pero-el-client-ho-demana
LLM_MODEL=qwen2.5:7b
# Model per a consultes en català. Ha de ser un model REALMENT instal·lat al teu
# servidor d'inferència (p. ex. `ollama pull qwen2.5:7b`). Si hi poses un model que
# no existeix (p. ex. un de HuggingFace no descarregat), el xat en català fallarà.
LLM_MODEL_CATALA=qwen2.5:7b
# Model BATCH / no interactiu (generació de documents, anàlisi). Pot ser un model
# gran (p. ex. qwen3-coder-rag, 30B MoE) on la latència no importa. Per defecte = LLM_MODEL.
LLM_MODEL_BATCH=qwen2.5:7b

# Embeddings i reranker (auto-allotjats dins el backend)
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_TOP_K=20
RAG_TOP_N=5

# vLLM (perfil gpu)
VLLM_MODEL=casperhansen/llama-3.3-70b-instruct-awq
VLLM_MAX_LEN=8192
HF_TOKEN=

# Frontend
VITE_API_BASE_URL=/api

# Seguretat
# SENTINELLA: genera'n un de fort abans d'usar fora de dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Amb ENTORN!=dev, la porta d'arrencada AVORTA si és aquest placeholder o és feble.
JWT_SECRET=CHANGEME-REQUIRED
# Originals dels documents xifrats en sobre (AES-256-GCM, lligat a centre, document i propòsit).
# DOCUMENTS_DATA_KEY: clau de 32 bytes en base64, FORA de la BD i del repositori:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# Sense clau, la ingesta d'un original SENSIBLE (i de qualsevol original amb ENTORN=prod, prod-local o
# prod-onprem) falla tancada en lloc de desar-lo en clar. Si es perd la clau, els originals xifrats no es
# poden tornar a obrir: guardeu-ne una còpia a part, com la de les còpies de seguretat.
# Rotació: la clau nova va a DOCUMENTS_DATA_KEY amb un DOCUMENTS_DATA_KEY_ID nou, i les antigues es
# conserven NOMÉS per llegir a DOCUMENTS_DATA_KEYS, en JSON {"id": "clau en base64", …}.
# DOCUMENTS_ALLOW_LEGACY_SENSITIVE=true deixa servir a prod els originals sensibles antics que encara són en
# clar: només mentre es migren.
DOCUMENTS_DATA_KEY=
DOCUMENTS_DATA_KEY_ID=v1
DOCUMENTS_DATA_KEYS={}
DOCUMENTS_ALLOW_LEGACY_SENSITIVE=false
AUDIT_LOG_PATH=/app/data/audit.log
# dev = sense porta de seguretat (només desenvolupament local).
# pilot-gcp | prod-onprem = la porta fail-closed exigeix secrets forts i inferència local.
ENTORN=dev

# ── Accés remot (Fase 1) ──
# Restringeix l'accés des de FORA de la xarxa local al rol d'administració
# (direcció/superadmin). Des de la xarxa local, tots els rols. `false` el desactiva.
ACCES_REMOT_ADMIN_ONLY=true
# Rang(s) d'IP de la xarxa local (CIDR, separats per comes). AJUSTA'L a la subxarxa
# del centre, p. ex.: XARXA_LOCAL_CIDRS=192.168.1.0/24
# Buit per defecte: cal indicar la LAN/VPN efectiva d'usuaris. No hi incloguis
# el bridge del proxy ni tots els rangs privats. Dev local: 127.0.0.1/32,::1/128.
XARXA_LOCAL_CIDRS=
# Darrere nginx activa-ho i defineix les IP/CIDR dels proxies reals (peer socket
# i intermediaris, p. ex. nginx + cloudflared). MAI 0.0.0.0/0, tota la LAN ni
# tot el bridge compartit: qualsevol peer d'aquests rangs podria aportar XFF.
# Sense confiança explícita, l'origen proxificat és remot/desconegut i els
# rols no administradors necessiten un origen verificat de la LAN/VPN.
PROXY_DE_CONFIANCA=false
PROXY_TRUSTED_CIDRS=

# Sessió del navegador: llista EXACTA d'orígens HTTPS que serveixen aquesta SPA.
# Producció: sense comodins; API al mateix origen sota /api. Cookie HttpOnly/Secure.
BROWSER_SESSION_ALLOWED_ORIGINS=
# Excepció NOMÉS ENTORN=dev i origen explícit localhost/loopback (HTTP).
BROWSER_SESSION_ALLOW_HTTP_DEV=false

# ── CORS i capçaleres de seguretat ──
# Orígens permesos per CORS, separats per comes. "*" (per defecte) és còmode en
# dev però NO es combina amb credencials i és insegur exposat a Internet. En
# producció posa-hi el/els domini(s) del frontend, p. ex.:
#   CORS_ORIGINS=https://patufet.exemple.cat,https://www.patufet.exemple.cat
CORS_ORIGINS=*
# Exposa /docs, /redoc i /openapi.json. En desplegament LOCAL/on-prem (LAN del
# centre, el mode de producció d'aquest projecte) és útil deixar-los actius. Si
# exposes l'API a Internet, posa-ho a false.
EXPOSA_DOCS=true

# Rate-limit del login (anti força bruta): bloqueig temporal del compte després
# de N fallits consecutius. Un login correcte reseteja el comptador.
LOGIN_MAX_INTENTS=5
LOGIN_BLOQUEIG_MINUTS=15

# ── Canal públic (Mòdul 1: WordPress / FAQ web) ──
# Token Bearer que la web pública envia al header X-Public-Token. NO és un token
# d'usuari; només acredita l'origen. Buit → canal desactivat (503).
# Genera'n un de fort: python -c "import secrets; print(secrets.token_urlsafe(32))"
PUBLIC_CHAT_TOKEN=
PUBLIC_CHAT_MAX_PER_MINUTE=5
PUBLIC_CHAT_INSTITUCIO=nou_patufet

# ── Servei intern (suite → core) ──
# Secret compartit que el suite (adeptify-suiterag) envia al header X-Service-Token
# (o Authorization: Bearer) per consumir POST /api/servei/*. NO és un token
# d'usuari. Buit → servei intern desactivat (503). Ha de coincidir EXACTAMENT amb
# el CORE_SERVICE_TOKEN del .env del suite.
# Genera'n un de fort: python -c "import secrets; print(secrets.token_urlsafe(32))"
CORE_SERVICE_TOKEN=

# ── Magatzem vectorial (Mòdul 3: abstracció pgvector ↔ Qdrant) ──
# pgvector = manté la BD Postgres com a vector store (per defecte).
# qdrant = col·leccions físicament separades per (institucio, namespace).
VECTOR_STORE=pgvector
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ── Bot Telegram (Mòdul 2: Zero-Trust + RBAC) ──
# Buit → bot desactivat. Per activar-lo: crea un bot amb BotFather i pega el token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MAGIC_LINK_MINUTS=5
TELEGRAM_APP_URL=http://localhost:5180

# ── Auditoria diària (Mòdul 4) ──
# Webhook on s'envia el report consolidat si la severitat és alta/crítica.
AUDIT_DIARIA_WEBHOOK=
AUDIT_DIARIA_EMAIL=
