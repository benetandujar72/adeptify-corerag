{
  "name": "ia-nou-patufet-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dashboard IA Nou Patufet — RAG self-hosted multi-agent per a l'Escola Nou Patufet",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-third-party-notices.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview --port 5173 --host 0.0.0.0",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "licenses:notices": "node scripts/generate-third-party-notices.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^5.4.10"
  }
}
