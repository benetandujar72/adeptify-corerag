# ============================================================
#  adeptify-corerag — .gitignore (hardened, zero-leak)
#  Goal: NEVER commit secrets, credentials or real (minors') PII.
# ============================================================

# --- Secrets / credentials (NEVER commit) ---
.env
.env.*
!.env.example
*.local
**/secrets*.json
**/credentials*.json
**/service_account*.json
**/*serviceaccount*.json
**/*-sa.json
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa*
id_ed25519*
.htpasswd
.netrc
*.gpg
*.asc

# --- Real data / PII (NEVER commit) ---
# sample_data/ is allowed but MUST contain ONLY synthetic data.
data/
pgdata/
backend_data/
hf_cache/
exports/
uploads/
*.sqlite
*.sqlite3
*.db
*.dump
*.bak
*.csv.real
*.pii.*

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# --- Node / frontend ---
node_modules/
dist/
build/
.vite/
.next/
coverage/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# --- Docker / runtime ---
*.pid
*.seed
.docker/

# --- OS / editor ---
.DS_Store
.AppleDouble
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# --- Misc / temp ---
*.tmp
.cache/
.playwright-mcp/
.markitdown/

# NOTE: never add exceptions (!) for files that may contain real secrets/PII.
